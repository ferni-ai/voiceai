{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Ferni Emotional Color Tokens - Colors that respond to mood and time",
  "_designPrinciples": {
    "moodResponsive": "Colors shift subtly based on emotional state",
    "timeFading": "Older memories desaturate (Gurney's atmospheric perspective)",
    "personaHarmony": "Smooth color transitions between personas (Albers)",
    "source": "Inspired by Josef Albers, James Gurney, and human color perception"
  },
  "moodPalettes": {
    "_comment": "Mood color adjustments applied to persona palettes (generated into apps/web emotional-tokens.generated.ts).",
    "backgroundTints": {
      "_comment": "Very subtle full-screen overlay tint per detected mood (used by apps/web mood-backgrounds.ui.ts)",
      "neutral": "rgba(255, 255, 255, 0)",
      "happy": "rgba(255, 220, 100, 0.03)",
      "excited": "rgba(255, 180, 120, 0.04)",
      "calm": "rgba(180, 220, 255, 0.03)",
      "thoughtful": "rgba(200, 180, 255, 0.03)",
      "sad": "rgba(180, 200, 220, 0.03)",
      "anxious": "rgba(200, 200, 220, 0.02)",
      "supportive": "rgba(220, 255, 200, 0.03)"
    },
    "states": {
      "calm": {
        "hueShift": -5,
        "saturationMultiplier": 0.85,
        "lightnessAdjustment": 3,
        "temperatureShift": -5,
        "character": "Cool, soft"
      },
      "joyful": {
        "hueShift": 10,
        "saturationMultiplier": 1.15,
        "lightnessAdjustment": 5,
        "temperatureShift": 10,
        "character": "Warm, bright"
      },
      "anxious": {
        "hueShift": 15,
        "saturationMultiplier": 0.9,
        "lightnessAdjustment": -5,
        "temperatureShift": 5,
        "character": "Tense, muted"
      },
      "tired": {
        "hueShift": 0,
        "saturationMultiplier": 0.7,
        "lightnessAdjustment": -10,
        "character": "Desaturated"
      },
      "focused": {
        "hueShift": -10,
        "saturationMultiplier": 1.1,
        "lightnessAdjustment": 0,
        "temperatureShift": -10,
        "character": "Cool, clear"
      },
      "reflective": {
        "hueShift": -15,
        "saturationMultiplier": 0.8,
        "lightnessAdjustment": 5,
        "temperatureShift": -15,
        "character": "Twilight, soft"
      },
      "stressed": {
        "hueShift": 5,
        "saturationMultiplier": 0.75,
        "lightnessAdjustment": -8,
        "character": "Muted, dim"
      },
      "energized": {
        "hueShift": 5,
        "saturationMultiplier": 1.2,
        "lightnessAdjustment": 8,
        "temperatureShift": 15,
        "character": "Vibrant"
      },
      "peaceful": {
        "hueShift": -20,
        "saturationMultiplier": 0.75,
        "lightnessAdjustment": 10,
        "temperatureShift": -20,
        "character": "Serene"
      }
    },
    "transitions": {
      "duration": "600ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "stagger": "50ms"
    }
  },
  "timeFading": {
    "_comment": "Atmospheric perspective for memories - older = more faded (Gurney)",
    "periods": {
      "now": {
        "saturation": 1,
        "lightnessShift": 0,
        "opacity": 1,
        "hueShift": 0,
        "blur": 0
      },
      "today": {
        "saturation": 0.95,
        "lightnessShift": 2,
        "opacity": 1,
        "hueShift": 0,
        "blur": 0
      },
      "yesterday": {
        "saturation": 0.88,
        "lightnessShift": 4,
        "opacity": 0.97,
        "hueShift": 2,
        "blur": 0
      },
      "thisWeek": {
        "saturation": 0.78,
        "lightnessShift": 7,
        "opacity": 0.94,
        "hueShift": 5,
        "blur": 0.5
      },
      "lastWeek": {
        "saturation": 0.68,
        "lightnessShift": 10,
        "opacity": 0.9,
        "hueShift": 8,
        "blur": 0.75
      },
      "thisMonth": {
        "saturation": 0.55,
        "lightnessShift": 14,
        "opacity": 0.85,
        "hueShift": 12,
        "blur": 1
      },
      "lastMonth": {
        "saturation": 0.42,
        "lightnessShift": 18,
        "opacity": 0.78,
        "hueShift": 16,
        "blur": 1.25
      },
      "older": {
        "saturation": 0.3,
        "lightnessShift": 22,
        "opacity": 0.7,
        "hueShift": 20,
        "blur": 1.5
      },
      "ancient": {
        "saturation": 0.18,
        "lightnessShift": 26,
        "opacity": 0.6,
        "hueShift": 25,
        "blur": 2
      }
    },
    "colorShiftByAge": {
      "_comment": "Older memories shift toward sepia/warm tones",
      "recentHueShift": 0,
      "oldHueShift": 25,
      "ancientHueShift": 35
    },
    "atmosphericColors": {
      "_comment": "Colors that distant/old items shift toward, per persona (used by apps/web color/time-fading)",
      "ferni": "#8fa89a",
      "maya": "#c4a69a",
      "peter": "#8a9fab",
      "jordan": "#d4b09a",
      "alex": "#9aa4b8",
      "nayan": "#c8b08a",
      "default": "#a8b0b8"
    }
  },
  "personaTransitions": {
    "_comment": "Albers-inspired harmonic color transitions between personas",
    "bridgeColors": {
      "_comment": "Hand-tuned bridge colors for persona handoffs, keyed from-to (apps/web color/persona-harmony); other pairs are computed from the two persona colors",
      "ferni-maya": "#8a7a5a",
      "maya-ferni": "#8a7a5a",
      "ferni-peter": "#4a6a5a",
      "peter-ferni": "#4a6a5a",
      "ferni-nayan": "#7a8a5a",
      "nayan-ferni": "#7a8a5a",
      "maya-jordan": "#b87a6a",
      "jordan-maya": "#b87a6a",
      "peter-alex": "#4a6a7a",
      "alex-peter": "#4a6a7a",
      "alex-nayan": "#8a8a7a",
      "nayan-alex": "#8a8a7a"
    },
    "defaultTransition": {
      "steps": 5,
      "duration": "700ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "fallbackBridgeColor": "#888888"
  },
  "simultaneousContrast": {
    "_comment": "Albers: colors change appearance based on neighbors",
    "rules": {
      "avoidClash": {
        "description": "When two persona colors are adjacent, apply subtle adjustment",
        "saturationReduction": 0.1,
        "lightnessAdjustment": 5
      },
      "enhanceHarmony": {
        "description": "When colors are harmonious, enhance both slightly",
        "saturationBoost": 0.05,
        "contrastEnhance": 3
      }
    },
    "contextAdjustments": {
      "darkBackground": {
        "lightnessBoost": 10,
        "saturationBoost": 0.1
      },
      "lightBackground": {
        "lightnessReduction": 5,
        "saturationReduction": 0.05
      }
    }
  },
  "emotionalColorMapping": {
    "_comment": "Direct mapping of emotions to color associations",
    "emotions": {
      "love": {
        "hue": 350,
        "saturation": 75,
        "lightness": 60
      },
      "joy": {
        "hue": 45,
        "saturation": 85,
        "lightness": 65
      },
      "trust": {
        "hue": 200,
        "saturation": 60,
        "lightness": 50
      },
      "fear": {
        "hue": 270,
        "saturation": 40,
        "lightness": 35
      },
      "surprise": {
        "hue": 30,
        "saturation": 90,
        "lightness": 70
      },
      "sadness": {
        "hue": 220,
        "saturation": 35,
        "lightness": 40
      },
      "disgust": {
        "hue": 100,
        "saturation": 30,
        "lightness": 35
      },
      "anger": {
        "hue": 0,
        "saturation": 80,
        "lightness": 45
      },
      "anticipation": {
        "hue": 35,
        "saturation": 70,
        "lightness": 60
      },
      "hope": {
        "hue": 160,
        "saturation": 55,
        "lightness": 55
      },
      "gratitude": {
        "hue": 85,
        "saturation": 50,
        "lightness": 50
      },
      "contentment": {
        "hue": 140,
        "saturation": 40,
        "lightness": 55
      }
    }
  },
  "cssVariableMapping": {
    "_comment": "How these tokens map to CSS custom properties",
    "moodPalette": {
      "primaryVar": "--mood-color-primary",
      "secondaryVar": "--mood-color-secondary",
      "accentVar": "--mood-color-accent",
      "backgroundVar": "--mood-color-background"
    },
    "timeFading": {
      "saturationVar": "--time-fade-saturation",
      "opacityVar": "--time-fade-opacity",
      "blurVar": "--time-fade-blur"
    },
    "transition": {
      "bridgeColorVar": "--persona-transition-bridge",
      "progressVar": "--persona-transition-progress"
    }
  },
  "accessibilityRequirements": {
    "_comment": "Ensure emotional colors meet accessibility standards",
    "contrastMinimum": {
      "normalText": 4.5,
      "largeText": 3.0,
      "uiComponents": 3.0
    },
    "colorBlindSafe": {
      "avoidRedGreenAlone": true,
      "useShapeAndPattern": true,
      "provideTextAlternatives": true
    },
    "reducedMotion": {
      "disableColorTransitions": false,
      "instantTransitions": true
    }
  },
  "personaMoodBase": {
    "_comment": "Per-persona accent and background tint for mood palettes; primary comes from colors.json personas.",
    "ferni": {
      "accent": "#3D5A45",
      "background": "#F5F2EE"
    },
    "maya": {
      "accent": "#8B5A4A",
      "background": "#FBF8F5"
    },
    "peter": {
      "accent": "#2A5B63",
      "background": "#F5F8F9"
    },
    "jordan": {
      "accent": "#A4654A",
      "background": "#FFFAF5"
    },
    "alex": {
      "accent": "#4A5B7A",
      "background": "#F5F7FA"
    },
    "nayan": {
      "accent": "#98754A",
      "background": "#FAF8F5"
    }
  },
  "semanticPalettes": {
    "_comment": "Earthy semantic state palettes (alternatives to red/yellow/green).",
    "error": {
      "primary": "#7a5a52",
      "secondary": "#5a4038",
      "light": "#a67a6a",
      "glow": "rgba(122, 90, 82, 0.35)",
      "text": "#ffffff"
    },
    "warning": {
      "primary": "#a6854a",
      "secondary": "#8a6d3a",
      "light": "#c4a265",
      "glow": "rgba(166, 133, 74, 0.35)",
      "text": "#ffffff"
    },
    "success": {
      "primary": "#4a6741",
      "secondary": "#3d5a35",
      "light": "#5a7a51",
      "glow": "rgba(74, 103, 65, 0.35)",
      "text": "#ffffff"
    },
    "info": {
      "primary": "#5a6b8a",
      "secondary": "#4a5a73",
      "light": "#7a8ba0",
      "glow": "rgba(90, 107, 138, 0.35)",
      "text": "#ffffff"
    },
    "neutral": {
      "primary": "#5C544A",
      "secondary": "#756A5E",
      "light": "#A89D90",
      "glow": "rgba(92, 84, 74, 0.25)",
      "text": "#ffffff"
    }
  },
  "holidayPalettes": {
    "_comment": "Seasonal/holiday themes in the earthy brand palette.",
    "valentines": {
      "primary": "#a67a6a",
      "secondary": "#8a635a",
      "accent": "#c4856a",
      "ambient": "rgba(166, 122, 106, 0.04)"
    },
    "spring": {
      "primary": "#4a6741",
      "secondary": "#5a7a51",
      "accent": "#b8956a",
      "ambient": "rgba(74, 103, 65, 0.03)"
    },
    "summer": {
      "primary": "#c4a265",
      "secondary": "#9a7b5a",
      "accent": "#c4856a",
      "ambient": "rgba(196, 162, 101, 0.04)"
    },
    "fall": {
      "primary": "#a86d55",
      "secondary": "#9a7b5a",
      "accent": "#7a5a52",
      "ambient": "rgba(168, 109, 85, 0.04)"
    },
    "halloween": {
      "primary": "#c4856a",
      "secondary": "#5a4038",
      "accent": "#a86d55",
      "ambient": "rgba(196, 133, 106, 0.05)"
    },
    "winter": {
      "primary": "#5a6b8a",
      "secondary": "#4a5a73",
      "accent": "#b8956a",
      "ambient": "rgba(90, 107, 138, 0.03)"
    },
    "christmas": {
      "primary": "#3d5a35",
      "secondary": "#7a5a52",
      "accent": "#c4a265",
      "ambient": "rgba(61, 90, 53, 0.04)"
    },
    "newYear": {
      "primary": "#b8956a",
      "secondary": "#5a6b8a",
      "accent": "#c4a265",
      "ambient": "rgba(184, 149, 106, 0.04)"
    }
  }
}
