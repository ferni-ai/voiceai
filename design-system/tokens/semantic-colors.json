      "roles": {
        "accent": { "light": "themes.zen.accent.primary", "dark": "themes.midnight.accent.primary" },
        "accent-hover": { "light": "themes.zen.accent.hover", "dark": "themes.midnight.accent.hover" },
        "accent-pressed": { "light": "themes.zen.accent.pressed", "dark": "themes.midnight.accent.pressed" },
        "accent-glow": { "light": "themes.zen.accent.glow", "dark": "themes.midnight.accent.glow" },
        "accent-subtle": { "light": "themes.zen.accent.subtle", "dark": "themes.midnight.accent.subtle" }
