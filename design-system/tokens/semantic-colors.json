{
  "description": "Website theme sets. Each role names one --color-* property (or the group's prefix) and its value in every theme, as a path into colors.json (spacing.json for a group with source spacing) or a literal. design-system/lib/website-theme.js turns it into the theme blocks of the website _tokens.css. colors.json stays hex/rgba because native apps read it; new theme structure goes here.",
  "_ownsLight": "A group with ownsLight has its light values emitted by website-theme.js at the end of the light :root; the older groups' light values still come from sync-promo-tokens.js.",
  "_lightOnly": "A role with no dark value keeps its light value in every theme and is left out of the dark blocks. The glass and cinematic shadow groups are for dark sections in both themes; they moved here from the hand-written src/css/tokens.css.",
  "_inverse": "A role's inverse context is its value inside [data-surface=\"inverse\"] (always-dark sections). Light values are today's literals on those sections; dark defaults to the light value until it is tuned.",

  "groups": [
    {
      "label": "Background",
      "roles": {
        "bg-primary": { "light": "themes.zen.background.primary", "dark": "themes.midnight.background.primary" },
        "bg-secondary": { "light": "themes.zen.background.secondary", "dark": "themes.midnight.background.secondary" },
        "bg-tertiary": { "light": "themes.zen.background.tertiary", "dark": "themes.midnight.background.tertiary" },
        "bg-elevated": { "light": "themes.zen.background.elevated", "dark": "themes.midnight.background.elevated" },
        "bg-glass": { "light": "themes.zen.background.glass", "dark": "themes.midnight.background.glass" },
        "bg-overlay": { "light": "themes.zen.background.overlay", "dark": "themes.midnight.background.overlay" },
        "bg": { "light": "themes.zen.background.primary", "dark": "themes.midnight.background.primary" },
        "bg-surface": { "light": "themes.zen.background.secondary", "dark": "themes.midnight.background.secondary" },
        "bg-warm": { "light": "themes.zen.background.tertiary", "dark": "themes.midnight.background.tertiary" },
        "elevated": { "light": "themes.zen.background.elevated", "dark": "themes.midnight.background.elevated" }
      }
    },
    {
      "label": "Text",
      "roles": {
        "text-primary": { "light": "themes.zen.text.primary", "dark": "themes.midnight.text.primary", "inverse": { "light": "themes.zen.text.inverse" } },
        "text-secondary": { "light": "themes.zen.text.secondary", "dark": "themes.midnight.text.secondary", "inverse": { "light": "rgba(255, 255, 255, 0.7)" } },
        "text-muted": { "light": "themes.zen.text.muted", "dark": "themes.midnight.text.muted", "inverse": { "light": "themes.midnight.text.muted" } },
        "text-dimmed": { "light": "themes.zen.text.dimmed", "dark": "themes.midnight.text.dimmed" },
        "text-inverse": { "light": "themes.zen.text.inverse", "dark": "themes.midnight.text.inverse" },
        "text": { "light": "themes.zen.text.primary", "dark": "themes.midnight.text.primary" },
        "background": { "light": "themes.zen.background.primary", "dark": "themes.midnight.background.primary" },
        "background-subtle": { "light": "themes.zen.background.secondary", "dark": "themes.midnight.background.secondary" },
        "background-muted": { "light": "themes.zen.background.tertiary", "dark": "themes.midnight.background.tertiary" },
        "background-surface": { "light": "themes.zen.background.secondary", "dark": "themes.midnight.background.secondary" },
        "background-elevated": { "light": "themes.zen.background.elevated", "dark": "themes.midnight.background.elevated" },
        "paper-cream": { "light": "themes.zen.natural.paperCream", "dark": "themes.midnight.background.primary" }
      }
    },
    {
      "label": "Accent",
      "roles": {
        "accent": { "light": "themes.zen.accent.primary", "dark": "themes.midnight.accent.primary", "inverse": { "light": "themes.midnight.accent.primary" } },
        "accent-hover": { "light": "themes.zen.accent.hover", "dark": "themes.midnight.accent.hover", "inverse": { "light": "themes.midnight.accent.hover" } },
        "accent-pressed": { "light": "themes.zen.accent.pressed", "dark": "themes.midnight.accent.pressed", "inverse": { "light": "themes.midnight.accent.pressed" } },
        "accent-glow": { "light": "themes.zen.accent.glow", "dark": "themes.midnight.accent.glow" },
        "accent-subtle": { "light": "themes.zen.accent.subtle", "dark": "themes.midnight.accent.subtle" }
      }
    },
    {
      "label": "Borders",
      "roles": {
        "border-subtle": { "light": "themes.zen.border.subtle", "dark": "themes.midnight.border.subtle", "inverse": { "light": "themes.midnight.border.subtle" } },
        "border-medium": { "light": "themes.zen.border.medium", "dark": "themes.midnight.border.medium" },
        "border-strong": { "light": "themes.zen.border.strong", "dark": "themes.midnight.border.strong", "inverse": { "light": "themes.midnight.border.strong" } }
      }
    },
    {
      "label": "Semantic",
      "roles": {
        "success": { "light": "themes.zen.semantic.success", "dark": "themes.midnight.semantic.success" },
        "success-bg": { "light": "themes.zen.semantic.successGlow", "dark": "themes.midnight.semantic.successGlow" },
        "error": { "light": "themes.zen.semantic.error", "dark": "themes.midnight.semantic.error" },
        "error-bg": { "light": "themes.zen.semantic.errorGlow", "dark": "themes.midnight.semantic.errorGlow" },
        "warning": { "light": "themes.zen.semantic.warning", "dark": "themes.midnight.semantic.warning" },
        "warning-bg": { "light": "themes.zen.semantic.warningGlow", "dark": "themes.midnight.semantic.warningGlow" }
      }
    },
    {
      "label": "Surfaces",
      "ownsLight": true,
      "roles": {
        "surface-base": { "light": "themes.zen.background.primary", "dark": "themes.midnight.background.primary", "inverse": { "light": "themes.zen.text.primary" } },
        "surface-sunken": { "light": "themes.zen.background.secondary", "dark": "themes.midnight.background.secondary", "inverse": { "light": "cinematic.black.rich" } },
        "surface-raised": { "light": "#ffffff", "dark": "themes.midnight.background.tertiary", "inverse": { "light": "rgba(255, 255, 255, 0.08)" } },
        "surface-overlay": { "light": "themes.zen.background.elevated", "dark": "themes.midnight.background.elevated", "inverse": { "light": "themes.midnight.background.elevated" } },
        "on-accent": { "light": "themes.zen.text.onAccent", "dark": "themes.midnight.text.onAccent", "inverse": { "light": "themes.midnight.text.onAccent" } },
        "brand-text": { "light": "personas.ferni.primary", "dark": "personas.ferni.textOnDark", "inverse": { "light": "personas.ferni.textOnDark" } }
      }
    },
    {
      "label": "Shadows",
      "ownsLight": true,
      "prefix": "--shadow-",
      "source": "spacing",
      "roles": {
        "raised": { "light": "shadows.zen.md", "dark": "shadows.midnight.md", "inverse": { "light": "shadows.midnight.md" } },
        "overlay": { "light": "shadows.zen.xl", "dark": "shadows.midnight.xl", "inverse": { "light": "shadows.midnight.xl" } }
      }
    },
    {
      "label": "Cinematic shadows (dark sections)",
      "ownsLight": true,
      "prefix": "--shadow-",
      "roles": {
        "cinematic-sm": { "light": "0 4px 16px rgba(0, 0, 0, 0.4)" },
        "cinematic-md": { "light": "0 8px 32px rgba(0, 0, 0, 0.5)" },
        "cinematic-lg": { "light": "0 16px 64px rgba(0, 0, 0, 0.6)" },
        "cinematic-xl": { "light": "0 32px 128px rgba(0, 0, 0, 0.7)" },
        "glow-white": { "light": "0 0 40px rgba(255, 255, 255, 0.15)" },
        "glow-accent": { "light": "0 0 60px rgba(74, 103, 65, 0.3)" }
      }
    },
    {
      "label": "Glass buttons",
      "ownsLight": true,
      "prefix": "--glass-",
      "roles": {
        "btn-bg": { "light": "rgba(255, 255, 255, 0.08)" },
        "btn-bg-hover": { "light": "rgba(255, 255, 255, 0.14)" },
        "btn-border": { "light": "1px solid rgba(255, 255, 255, 0.12)" },
        "btn-border-hover": { "light": "1px solid rgba(255, 255, 255, 0.2)" },
        "btn-shadow": { "light": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 4px 24px rgba(0, 0, 0, 0.15)" },
        "light-btn-bg": { "light": "rgba(0, 0, 0, 0.04)" },
        "light-btn-border": { "light": "1px solid rgba(0, 0, 0, 0.08)" }
      }
    },
    {
      "label": "Ferni glass - warm cream tint on dark backgrounds",
      "ownsLight": true,
      "prefix": "--ferni-glass-",
      "roles": {
        "btn-bg": { "light": "rgba(245, 241, 232, 0.06)" },
        "btn-bg-hover": { "light": "rgba(245, 241, 232, 0.12)" },
        "btn-border": { "light": "1px solid rgba(245, 241, 232, 0.1)" },
        "btn-border-hover": { "light": "1px solid rgba(245, 241, 232, 0.2)" },
        "primary-bg": { "light": "rgba(61, 90, 69, 0.15)" },
        "primary-bg-hover": { "light": "rgba(61, 90, 69, 0.25)" },
        "primary-glow": { "light": "0 0 40px rgba(61, 90, 69, 0.25)" }
      }
    }
  ],

  "personaRoles": {
    "label": "Persona Text Colors - WCAG AA on dark backgrounds",
    "description": "One role per persona in colors.json: --color-<short id>-<suffix>. Values are keys of that persona; a persona without the dark key keeps its light value.",
    "roles": {
      "text": { "light": "primary", "dark": "textOnDark" }
    }
  }
}
