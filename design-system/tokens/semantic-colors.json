{
  "description": "Website theme sets. Each role names one --color-* property and its value in every theme, as a path into colors.json (or a literal colour). design-system/lib/website-theme.js turns it into the dark blocks of the website _tokens.css. colors.json stays hex/rgba because native apps read it; new theme structure goes here.",

  "groups": [
    {
      "label": "Background",
      "roles": {
        "bg-primary": { "light": "themes.zen.background.primary", "dark": "themes.midnight.background.primary" },
        "bg-secondary": { "light": "themes.zen.background.secondary", "dark": "themes.midnight.background.secondary" },
        "bg-tertiary": { "light": "themes.zen.background.tertiary", "dark": "themes.midnight.background.tertiary" },
        "bg-elevated": { "light": "themes.zen.background.elevated", "dark": "themes.midnight.background.elevated" },
        "bg-glass": { "light": "themes.zen.background.glass", "dark": "themes.midnight.background.glass" },
        "bg-overlay": { "light": "themes.zen.background.overlay", "dark": "themes.midnight.background.overlay" },
        "bg": { "light": "themes.zen.background.primary", "dark": "themes.midnight.background.primary" },
        "bg-surface": { "light": "themes.zen.background.secondary", "dark": "themes.midnight.background.secondary" },
        "bg-warm": { "light": "themes.zen.background.tertiary", "dark": "themes.midnight.background.tertiary" },
        "elevated": { "light": "themes.zen.background.elevated", "dark": "themes.midnight.background.elevated" }
