        "text-inverse": { "light": "themes.zen.text.inverse", "dark": "themes.midnight.text.inverse" },
        "text": { "light": "themes.zen.text.primary", "dark": "themes.midnight.text.primary" },
        "background": { "light": "themes.zen.background.primary", "dark": "themes.midnight.background.primary" },
        "background-subtle": { "light": "themes.zen.background.secondary", "dark": "themes.midnight.background.secondary" },
        "background-muted": { "light": "themes.zen.background.tertiary", "dark": "themes.midnight.background.tertiary" },
