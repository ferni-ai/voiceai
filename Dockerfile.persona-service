# syntax=docker/dockerfile:1.4
# Persona Service Dockerfile
#
# Lightweight container for persona/agent context service.
#
# Build:
#   docker build -f Dockerfile.persona-service -t ferni-persona-service .
#
# Run:
#   docker run -p 50052:50052 --env-file .env ferni-persona-service

FROM node:22-slim AS base
WORKDIR /app

# Same pnpm as package.json "packageManager" (pnpm@latest drifts from the lockfile)
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate

# The workspace manifests, patches and .npmrc the lockfile needs for a frozen install
# (same set as docker/Dockerfile.ui)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches/ ./patches/
COPY apps/cli/package.json ./apps/cli/
COPY apps/web/package.json ./apps/web/
COPY apps/async/package.json ./apps/async/
COPY apps/intelligence-worker/package.json ./apps/intelligence-worker/
COPY apps/rust-audio/package.json ./apps/rust-audio/
COPY apps/rust-perf/package.json ./apps/rust-perf/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY design-system/package.json ./design-system/

# ============================================================================
# Dependencies stage
# ============================================================================
FROM base AS deps

# Install dependencies (production only for smaller image)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod

# ============================================================================
# Build stage
# ============================================================================
FROM base AS builder

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source, and the whole CLI tree the build script runs from (its imports
# change; copying build-fast.ts alone broke this image when it moved)
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY apps/cli/src ./apps/cli/src

# Build with esbuild (fast!)
RUN npx tsx apps/cli/src/commands/build/build-fast.ts

# ============================================================================
# Production stage
# ============================================================================
FROM node:22-slim AS production

WORKDIR /app

# Copy production dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY package.json ./

# Copy persona bundles (needed for content)
COPY --from=builder /app/src/personas/bundles ./src/personas/bundles

# Set environment
ENV NODE_ENV=production
ENV PORT=50052

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:50052/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

# Run the service
EXPOSE 50052
CMD ["node", "dist/services/persona-service/server.js"]
