rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if the authenticated user owns this document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if user has admin claim
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    // Check if user is a service account (backend)
    function isServiceAccount() {
      return isSignedIn() && request.auth.token.service_account == true;
    }
    
    // Rate limiting check (max 100 writes per hour per user)
    // Note: This is a soft limit - real rate limiting is in auth-middleware.ts
    
    // ============================================================================
    // USER PROFILES (bogle_users collection)
    // This is the PRIMARY user data store - MOST SENSITIVE
    // ============================================================================
    
    match /bogle_users/{userId} {
      // Owners read their own profile; admin/service accounts read any (support).
      allow read: if isOwner(userId) || isAdmin() || isServiceAccount();

      // No client writes, ever. Every write goes through the server (Admin SDK,
      // which bypasses these rules), which checks what it writes. This doc holds
      // whom we may text or call (linkedIdentifiers, outreachPreferences) and
      // billing state (tier, subscription*): a client writing
      // linkedIdentifiers: ['phone:+1<someone>'] plus sms consent would have
      // gotten that person texted. No first-party client uses the Firestore SDK
      // (web is auth-only; native apps have none), so nothing breaks.
      // isAdmin here grants nothing: the server reads admin from Firebase
      // custom claims (request.auth.token.admin), not from this document.
      allow create, update: if isServiceAccount();

      // Only admins can delete profiles (GDPR requests go through admin)
      allow delete: if isAdmin();

      // Subcollections: owner reads, server writes. Any subcollection not
      // listed here is denied to clients entirely (the default).
      match /summaries/{summaryId} {
        allow read: if isOwner(userId) || isServiceAccount();
        allow write: if isServiceAccount();
      }

      match /moments/{momentId} {
        allow read: if isOwner(userId) || isServiceAccount();
        allow write: if isServiceAccount();
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId) || isServiceAccount();
        allow write: if isServiceAccount();
      }

      // Trust profiles (boundaries, growth, inside jokes, etc.)
      match /trust_profiles/{profileId} {
        allow read: if isOwner(userId) || isServiceAccount();
        allow write: if isServiceAccount();
      }

      // Utility preferences (timers, tips, timezone patterns, etc.)
      match /utility_preferences/{prefId} {
        allow read: if isOwner(userId) || isServiceAccount();
        allow write: if isServiceAccount();
      }

      // Group conversation sessions (Team Roundtables, Conference Calls)
      match /group_sessions/{sessionId} {
        allow read: if isOwner(userId) || isServiceAccount();
        allow write: if isServiceAccount();
      }

      // Social graph (people mentioned in conversations)
      match /social_graph/{docId} {
        allow read: if isOwner(userId) || isServiceAccount();
        allow write: if isServiceAccount();
      }

      // Activity ledger (activity-store.ts): what Ferni did or promised for the
      // owner, and each record's event log. Written only by the server's
      // recordActivity (compare-and-set on revision), never by a client.
      match /activity/{activityId} {
        allow read: if isOwner(userId) || isServiceAccount();
        allow write: if isServiceAccount();

        match /events/{seq} {
          allow read: if isOwner(userId) || isServiceAccount();
          allow write: if isServiceAccount();
        }
      }

      // Facts (memory/facts/facts-store.ts): what Ferni knows about people, some of it
      // sensitive. Read and written only by the server's memory writer, never a client.
      match /facts/{factId} {
        allow read, write: if isServiceAccount();
      }
    }
    
    // ============================================================================
    // LEGACY users COLLECTION (for Firebase Auth integration)
    // ============================================================================
    
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // ============================================================================
    // SECURITY EVENTS (audit log - write only)
    // ============================================================================
    
    match /security_events/{eventId} {
      // Only service accounts can write security events
      allow create: if isServiceAccount();
      // Only admins can read security events
      allow read: if isAdmin();
      // No updates or deletes - audit trail must be immutable
      allow update, delete: if false;
    }
    
    // ============================================================================
    // REPORTED REPLIES (POST /api/reports; the server writes with the Admin SDK)
    // Holds a reply and the person's words before it: admins read, nobody else.
    // ============================================================================

    match /reply_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reply_report_quota/{uid} {
      allow read, write: if false;
    }

    // Daily email counters (api/waitlist-email-quota.ts): server only
    match /ops_email_quota/{day} {
      allow read, write: if false;
    }

    // ============================================================================
    // PHONE LOOKUP INDEX (for cross-device identification)
    // Stores hashed phone -> userId mappings
    // ============================================================================
    
    match /phone_index/{hashedPhone} {
      // Only service accounts can read/write (backend manages this)
      allow read, write: if isServiceAccount();
    }
    
    // ============================================================================
    // OPTIMIZATION & ANALYTICS DATA
    // Server-only. These hold other people's uids, session ids and message text
    // (optimization_feedback.userMessage) and feed the optimizer, so no ordinary
    // client reads or writes them. The server writes with the Admin SDK, which
    // bypasses these rules; no first-party client uses the Firestore SDK.
    // ============================================================================
    
    match /optimization_feedback/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    match /optimization_recommendations/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    match /optimization_experiments/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    match /optimization_sessions/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    match /optimization_patterns/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    match /optimization_cycles/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    match /optimization_daily_summaries/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    match /optimization_weekly_reports/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    // ============================================================================
    // TOOL USAGE ANALYTICS (server-only, same reason as above)
    // ============================================================================
    
    match /tool_usage_stats/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    match /tool_usage_calls/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }
    
    // ============================================================================
    // LEARNING SIGNALS (server-only, same reason as above)
    // ============================================================================

    match /learning_signals/{document=**} {
      allow read: if isAdmin() || isServiceAccount();
      allow write: if isServiceAccount();
    }

    // ============================================================================
    // MARKETPLACE - Tools & Agents Registry
    // ============================================================================

    // A client-created manifest is unverified and at most community trust.
    // trustLevel picks the execution sandbox, so a client may not claim more.
    function clientVerificationOk(data) {
      return data.get('verification', {}).get('verified', false) == false &&
        data.get('verification', {}).get('trustLevel', 'unverified') in ['unverified', 'community'];
    }

    // Tool manifests - public read, publisher/admin write
    match /marketplace_tools/{toolId} {
      // Anyone can read verified tools
      allow read: if resource.data.verification.verified == true || isAdmin() || isServiceAccount();
      // Publishers create their own tools, unverified. Verification and the
      // publisher are set by the server/admins only: an owner update may not
      // touch either, or a publisher could self-verify (which makes the doc
      // public above) or hand the doc to someone else.
      allow create: if isOwner(request.resource.data.publisher.id) &&
        clientVerificationOk(request.resource.data);
      allow update: if isAdmin() || isServiceAccount() || (
        isOwner(resource.data.publisher.id) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verification', 'publisher'])
      );
      allow delete: if isAdmin();
    }

    // Agent manifests - public read, publisher/admin write
    match /marketplace_agents/{agentId} {
      // Anyone can read verified agents
      allow read: if resource.data.verification.verified == true || isAdmin() || isServiceAccount();
      // Publishers create their own agents, unverified. Verification and the
      // publisher are set by the server/admins only: an owner update may not
      // touch either, or a publisher could self-verify (which makes the doc
      // public above) or hand the doc to someone else.
      allow create: if isOwner(request.resource.data.publisher.id) &&
        clientVerificationOk(request.resource.data);
      allow update: if isAdmin() || isServiceAccount() || (
        isOwner(resource.data.publisher.id) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verification', 'publisher'])
      );
      allow delete: if isAdmin();
    }

    // ============================================================================
    // MARKETPLACE - User Installations
    // ============================================================================

    match /marketplace_installations/{installationId} {
      // Users can only read their own installations
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Users can install items for themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Users can update their own installations (enable/disable), but not
      // move one onto someone else's account
      allow update: if isOwner(resource.data.userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId']);
      // Users can uninstall their own items
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Service accounts can manage all installations
      allow read, write: if isServiceAccount();
    }

    // ============================================================================
    // MARKETPLACE - Execution Audit Log
    // ============================================================================

    match /marketplace_executions/{executionId} {
      // Users can read their own executions
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Only service accounts can write (backend records executions)
      allow create: if isServiceAccount();
      // Executions are immutable
      allow update, delete: if false;
      // Publishers can read executions for their tools
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
    }

    // ============================================================================
    // MARKETPLACE - Usage & Billing
    // ============================================================================

    match /marketplace_usage/{usageId} {
      // Users can read their own usage
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Only service accounts can write usage records
      allow create, update: if isServiceAccount();
      // Usage records are immutable once created
      allow delete: if false;
    }

    // Monthly usage aggregates per user+item
    match /marketplace_usage_monthly/{aggregateId} {
      // Users can read their own aggregates
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Only service accounts can write
      allow write: if isServiceAccount();
    }

    // ============================================================================
    // MARKETPLACE - Revenue Share (Publishers)
    // ============================================================================

    match /marketplace_revenue_shares/{shareId} {
      // Publishers can read their own revenue shares
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Only service accounts can write (billing system)
      allow write: if isServiceAccount();
      // Admins can read all
      allow read: if isAdmin();
    }

    // ============================================================================
    // MARKETPLACE - Publisher Profiles
    // ============================================================================

    match /marketplace_publishers/{publisherId} {
      // Public read for verified publishers
      allow read: if resource.data.verified == true || isAdmin() || isServiceAccount();
      // Publishers create and update their own profile, but `verified` is set
      // by the server (Admin SDK) only
      allow create: if isOwner(publisherId) &&
        request.resource.data.get('verified', false) == false;
      allow update: if isOwner(publisherId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']);
      // Only admins can delete publishers
      allow delete: if isAdmin();
    }

    // ============================================================================
    // DEVELOPER PLATFORM v2 - MCP Servers
    // ============================================================================

    match /developer_mcp_servers/{serverId} {
      // Publishers read their own MCP server registrations. No client writes: they go through
      // /api/v2/developers, which validates them (URLs, configs) server-side.
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Service accounts and admins have full access
      allow read, write: if isServiceAccount() || isAdmin();
    }

    // ============================================================================
    // DEVELOPER PLATFORM v2 - Custom Tools
    // ============================================================================

    match /developer_tools/{toolId} {
      // Publishers read their own custom tools. No client writes: they go through
      // /api/v2/developers, which validates them (URLs, configs) server-side.
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Service accounts and admins have full access
      allow read, write: if isServiceAccount() || isAdmin();
    }

    // ============================================================================
    // DEVELOPER PLATFORM v2 - Webhooks
    // ============================================================================

    match /developer_webhooks/{webhookId} {
      // Publishers read their own webhook subscriptions. No client writes: they go through
      // /api/v2/developers, which validates them (URLs, configs) server-side.
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Service accounts and admins have full access
      allow read, write: if isServiceAccount() || isAdmin();
    }

    match /developer_webhook_logs/{logId} {
      // Publishers can read logs for their webhooks
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Only service accounts can write logs
      allow write: if isServiceAccount();
      // Admins can read all
      allow read: if isAdmin();
    }

    // ============================================================================
    // DEVELOPER PLATFORM v2 - Activities
    // ============================================================================

    match /developer_activities/{activityId} {
      // Publishers read their own activities. No client writes: they go through
      // /api/v2/developers, which validates them (URLs, configs) server-side.
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Service accounts and admins have full access
      allow read, write: if isServiceAccount() || isAdmin();
    }

    // ============================================================================
    // DEVELOPER PLATFORM v2 - Workflows
    // ============================================================================

    match /developer_workflows/{workflowId} {
      // Publishers read their own workflows. No client writes: they go through
      // /api/v2/developers, which validates them (URLs, configs) server-side.
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Service accounts and admins have full access
      allow read, write: if isServiceAccount() || isAdmin();
    }

    match /workflow_executions/{executionId} {
      // Publishers can read executions for their workflows
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Only service accounts can create/update executions (workflow engine)
      allow write: if isServiceAccount();
      // Admins can read all
      allow read: if isAdmin();
    }

    // ============================================================================
    // DEVELOPER PLATFORM v2 - OAuth Providers
    // ============================================================================

    match /developer_oauth_providers/{providerId} {
      // Publishers read their own OAuth providers. No client writes: they go through
      // /api/v2/developers, which validates them (URLs, configs) server-side.
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Service accounts and admins have full access
      allow read, write: if isServiceAccount() || isAdmin();
    }

    match /developer_oauth_tokens/{tokenId} {
      // Users can read their own OAuth tokens
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Publishers can read tokens for their providers
      allow read: if isSignedIn() && resource.data.publisherId == request.auth.uid;
      // Only service accounts can write tokens (OAuth flow)
      allow write: if isServiceAccount();
      // Admins can read all
      allow read: if isAdmin();
    }

    // ============================================================================
    // DEFAULT DENY - Everything else is blocked
    // ============================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
