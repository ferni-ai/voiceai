{
  "version": 1,
  "lanes": {
    "crisis": {
      "paths": [
        "src/services/safety/**",
        "src/agents/safety/**",
        "src/tools/domains/crisis/**",
        "src/agents/shared/ai-notice.ts",
        "src/agents/multi-agent/ai-notice-wiring.ts",
        "src/config/flags/AI_NOTICE_SPOKEN.ts",
        "src/utils/minor-care*.ts",
        "src/services/human-transfer/**",
        "src/agents/processors/turn-processor/turn-crisis.ts",
        "src/agents/processors/turn-processor/safety-note.ts",
        "scripts/voice-eval/scenarios/*crisis*",
        "scripts/voice-eval/scenarios/minor-care-*",
        "scripts/voice-eval/release-check.mjs",
        "scripts/ci/autonomy-policy.json",
        "scripts/ci/autonomy-crisis-symbols.generated.json",
        "scripts/ci/crisis-symbols.ts"
      ],
      "changedLinePatterns": [
        "\\b988\\b",
        "MINOR_CARE",
        "minorCare|memoryHeld\\(",
        "suicid|self-?harm",
        "aiNotice|AI_NOTICE",
        "(?:\\bimport\\b|\\brequire\\s*\\(|\\bfrom\\b).*['\"`][^'\"`]*(?:services/safety|agents/safety|domains/crisis|human-transfer|minor-care|ai-notice)",
        "nine[- ]?eight[- ]?eight"
      ],
      "joinedLinePatterns": ["(?<!\\d)988(?!\\d)", "(?<!\\d)9\\W{0,3}8\\W{0,3}8(?!\\d)"],
      "importFallbackPattern": "(?:/safety/|crisis|safety-note|human-transfer|minor-care|ai-notice)",
      "symbolsFile": "autonomy-crisis-symbols.generated.json",
      "alwaysScreen": [
        "addSafetyNote",
        "detectCrisis",
        "hadRecentCrisis",
        "CRISIS_QUIET_DAYS",
        "getCrisisResources",
        "getGroundingExercise",
        "lastFerniLine"
      ],
      "unscreened": []
    },
    "privacy": {
      "paths": ["src/**", "apps/**", "!**/*.md"],
      "pathPattern": "(grief|bereave|persistence/|identity|user-id|caller-id|placeholder|synthetic-write|privacy|erase|erasure|forget|recall|user-stores|tool-policy|persona-tool|protected-tool|startup-log|call-log|logger|telemetry|transcript)"
    },
    "evaluator": {
      "paths": [
        "scripts/voice-eval/**",
        "!scripts/voice-eval/scenarios/**",
        "scripts/autonomy/**",
        "scripts/ci/lead-verified.ts",
        "scripts/ci/autonomy-lanes.ts",
        ".github/workflows/autonomy-lanes.yml",
        ".github/CODEOWNERS"
      ]
    }
  },
  "approvers": { "crisis": ["sethdford"] },
  "evaluatorAuthors": ["ferni-eval[bot]"],
  "loopAuthors": ["ferni-loop[bot]"],
  "loopBranchPrefix": "loop/"
}
