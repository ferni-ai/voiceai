        { "id": "recall", "metric": "recallRate", "better": "higher", "warn": 0.7, "fail": 0.5, "why": "10-21 dev 0.5" },
        { "id": "invented", "metric": "inventedShare", "better": "lower", "warn": 0, "fail": 0.25, "why": "judge inventedHistory should be empty" }
      ]
    },
