    },
    "bh-sample": {
      "label": "Better-than-human sample", "scenarios": ["bh-01", "bh-05", "bh-09", "bh-13", "bh-17", "bh-20"],
      "checks": [
        { "id": "human", "metric": "judgeMean", "dim": "humanLikelihood", "better": "higher", "warn": 0.5, "fail": 0.25, "maxDrop": 0.1, "why": "10-21 dev mean 0.31; bh-17 and bh-20 collapse" }
      ]
