        { "id": "endearing", "metric": "judgeMean", "dim": "endearing", "scope": "all", "better": "higher", "warn": null, "fail": null, "maxDrop": 0.3 },
        { "id": "conduct", "metric": "judgeMean", "dim": "conduct", "scope": "all", "better": "higher", "warn": null, "fail": null, "maxDrop": 0.3 }
