#!/usr/bin/env sh

# =============================================================================
# PRE-COMMIT QUALITY GATES
# =============================================================================
# Validates code quality before allowing commits.
# Run `git commit --no-verify` to bypass (use sparingly!)
# =============================================================================

set -e  # Exit on first error

# A check that warns without blocking adds to this, and the closing line says so:
# "all passed" after a warning would say the opposite of what happened (#3884).
# No check below hides its stderr, so a check that crashed says it crashed.
WARNINGS=0
warn() { WARNINGS=$((WARNINGS + 1)); }

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║  FERNI PRE-COMMIT QUALITY GATES                              ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""

# =============================================================================
# QUICK CHECKS (Must pass)
# =============================================================================
echo "🔍 Running quick quality checks..."
echo ""

# TypeScript type check (fast, catches type errors)
echo "  → TypeScript type check..."
# The flag barrel and env-name list are gitignored; write them for this tree first.
npx tsx src/config/generated-lists.ts >/dev/null
NODE_OPTIONS='--max-old-space-size=8192' npx tsc --noEmit --pretty

# ESLint (catches code quality issues)
echo "  → ESLint..."
npm run lint --silent 2>/dev/null || npm run lint

# Format ratchet: a src file prettier would reformat fails unless it is in the
# baseline of files unformatted before 2026-11-02 (the same gate CI runs).
echo "  → Prettier format ratchet..."
npx tsx apps/cli/src/commands/quality/format-ratchet.ts || {
  echo ""
  echo "  ❌ FORMATTING - COMMIT BLOCKED (files named above; 'npx prettier --write <file>')"
  echo ""
  exit 1
}

echo ""
echo "  ✓ Quick checks passed"

# =============================================================================
# DEPLOYMENT SAFETY CHECK (BLOCKS COMMIT)
# =============================================================================
echo ""
echo "🚀 Deployment safety check..."

# Check for unsafe deployment patterns
npx tsx apps/cli/src/commands/quality/check-deploy-safety.ts || {
  echo ""
  echo "  ❌ DEPLOYMENT SAFETY CHECK FAILED - COMMIT BLOCKED"
  echo ""
  echo "  Its output is above: an unsafe pattern, or the check itself crashed."
  echo "  Use 'ferni deploy' instead of direct gcloud/firebase commands"
  echo ""
  exit 1
}

echo "  ✓ Deployment safety check passed"

# =============================================================================
# CODE QUALITY AUDIT (Informational)
# =============================================================================
echo ""
echo "📊 Running code quality audit..."

# Run quality check but don't block on warnings
npx tsx apps/cli/src/commands/quality/code-quality-check.ts || {
  warn
  echo ""
  echo "  ⚠ Quality check failed, output above (non-blocking)"
  echo "  Run 'npm run audit quality' for details"
}

# =============================================================================
# DESIGN SYSTEM VALIDATION (AUTO-REGENERATE)
# =============================================================================
echo ""
echo "🎨 Design system checks..."

# Check for token drift - auto-regenerate if detected
if ! node design-system/check-drift.js 2>/dev/null; then
  echo ""
  echo "  ⚠ Token drift detected - auto-regenerating..."
  npm run tokens:sync --silent

  # Stage the regenerated files
  git add design-system/dist/ 2>/dev/null || true
  git add apps/web/src/config/animation-constants.generated.ts 2>/dev/null || true
  git add apps/web/public/design-system/tokens.css 2>/dev/null || true
  git add apps/website/ferni-website/tailwind.config.generated.js 2>/dev/null || true
  git add apps/website/ferni-website/css/design-tokens.css 2>/dev/null || true
  git add apps/website/ferni-website/src/css/_tokens.css 2>/dev/null || true
  git add apps/website/developers-portal/src/css/tokens.css 2>/dev/null || true
  git add apps/website/design-system-portal/src/css/tokens.css 2>/dev/null || true
  git add brand/ferni-design-tokens.css 2>/dev/null || true

  echo "  ✓ Tokens regenerated and staged"
fi

# Check brand color alignment - BLOCKS commit if critical mismatches
node design-system/check-brand.js || {
  echo ""
  echo "  ❌ BRAND COLOR MISALIGNMENT - COMMIT BLOCKED"
  echo ""
  echo "  Fix: Update design-system/tokens/colors.json to match brand guidelines"
  echo "  Then: npm run tokens:sync && git add -A"
  echo ""
  exit 1
}

echo "  ✓ Design system checks passed"

# =============================================================================
# DESIGN SYSTEM COMPLIANCE (Non-blocking warnings)
# =============================================================================
echo ""
echo "🔍 Design system compliance..."

# Check for hardcoded colors, durations, console.logs in staged files
node design-system/check-design-compliance.js --staged || {
  warn
  echo ""
  echo "  ⚠ Design compliance check failed, output above (non-blocking)"
  echo "  Run 'npm run design:check' for details"
}

echo "  ✓ Design compliance check complete"

# =============================================================================
# BRAND COMPLIANCE CHECK (Non-blocking warnings)
# =============================================================================
echo ""
echo "🌿 Brand compliance check..."

# Run brand check on staged files - warns but doesn't block
npx tsx apps/cli/src/commands/quality/check-brand-compliance.ts --staged || {
  warn
  echo ""
  echo "  ⚠ Brand check failed, output above (non-blocking)"
  echo "  Run 'npm run brand:check' for details"
}

echo "  ✓ Brand check complete"

# =============================================================================
# TOOL SCHEMA VALIDATION (Auto-regenerate if needed)
# =============================================================================
echo ""
echo "🔧 Tool schema checks..."

# Check if any schema files changed
SCHEMA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'src/tools/schemas/.*\.schema\.json$' || true)
if [ -n "$SCHEMA_FILES" ]; then
  echo "  Tool schemas modified - validating and regenerating..."
  
  # Validate schemas
  if ! npx tsx scripts/tools/validate-tool-schemas.ts; then
    echo ""
    echo "  ❌ TOOL SCHEMA VALIDATION FAILED - COMMIT BLOCKED"
    echo ""
    echo "  Run 'pnpm tools:schemas:validate' for details"
    echo ""
    exit 1
  fi
  
  # Regenerate files
  npx tsx scripts/tools/generate-all.ts || {
    warn
    echo ""
    echo "  ⚠ Tool schema generation failed (non-blocking)"
    echo "  Run 'pnpm tools:schemas:generate' to fix"
  }
  
  # Stage regenerated files
  git add src/tools/schemas/generated/ 2>/dev/null || true
  
  echo "  ✓ Tool schemas validated and regenerated"
else
  echo "  ✓ No tool schemas modified"
fi

# =============================================================================
# SECRET SCAN (BLOCKS COMMIT)
# =============================================================================
echo ""
echo "🔐 Secret scan of the staged changes..."

# Reads the lines this commit adds, from the index (what is committed, not the
# working tree), in every text file. A line with "gitleaks:allow" in it is skipped,
# the marker CI's gitleaks honors too. A scan that can't run blocks: an empty
# result from a failed read is not a clean scan. CI runs trufflehog and gitleaks.
# A sandboxed session may not be able to write to $TMPDIR (the Mac pr-reviver's
# commits failed here), so fall back to a directory inside this checkout's git dir,
# which a commit can always write to.
SCAN_DIR=$(mktemp -d 2>/dev/null) || SCAN_DIR=$(mktemp -d "$(git rev-parse --absolute-git-dir)/secret-scan.XXXXXX") || {
  echo ""
  echo "  ❌ SECRET SCAN COULD NOT RUN (no writable temp dir) - COMMIT BLOCKED"
  echo ""
  exit 1
}
scan_failed() {
  rm -rf "$SCAN_DIR"
  echo ""
  echo "  ❌ SECRET SCAN COULD NOT RUN ($1) - COMMIT BLOCKED"
  echo ""
  exit 1
}
git diff --cached --no-color --no-ext-diff -U0 --diff-filter=ACMR > "$SCAN_DIR/diff" || scan_failed "git diff"
# File headers come before a file's first @@; after it, a "+" line is content even
# when it reads "+++ ..." (an added line that starts with "++ ").
awk '/^diff --git /{ h = 0 } /^@@ /{ h = 1; next }
  !h && /^\+\+\+ /{ f = substr($0, 7); next }
  h && /^\+/{ print f "\t" substr($0, 2) }' "$SCAN_DIR/diff" > "$SCAN_DIR/added" || scan_failed "awk"
rc=0; grep -v -F 'gitleaks:allow' "$SCAN_DIR/added" > "$SCAN_DIR/checked" || rc=$?
[ "$rc" -le 1 ] || scan_failed "grep"
rc=0; grep -E '(sk_live_|AKIA[A-Z0-9]{16}|-----BEGIN.*PRIVATE KEY)' "$SCAN_DIR/checked" > "$SCAN_DIR/hits" || rc=$? # gitleaks:allow
[ "$rc" -le 1 ] || scan_failed "grep"
if [ "$rc" -eq 0 ]; then
  echo ""
  echo "  ❌ POSSIBLE SECRET STAGED - COMMIT BLOCKED, in:"
  cut -f1 "$SCAN_DIR/hits" | sort -u | sed 's/^/    /'
  echo ""
  echo "  Unstage it and rotate the key if it is real. A fake key in a test: end its"
  echo "  line with a 'gitleaks:allow' comment."
  echo ""
  rm -rf "$SCAN_DIR"
  exit 1
fi
rm -rf "$SCAN_DIR"

echo "  ✓ No secret pattern in the staged lines"

# =============================================================================
# DONE
# =============================================================================
echo ""
if [ "$WARNINGS" -eq 0 ]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  ✅ ALL PRE-COMMIT CHECKS PASSED                             ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
else
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  ⚠  BLOCKING CHECKS PASSED, WITH NON-BLOCKING WARNINGS       ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo "  $WARNINGS non-blocking check(s) failed: see the ⚠ lines above."
fi
echo ""
echo "┌──────────────────────────────────────────────────────────────┐"
echo "│  💭 HUMAN-NESS CHECK                                         │"
echo "│                                                              │"
echo "│  Before you commit, ask yourself:                            │"
echo "│  → Does this make the AI feel more human?                    │"
echo "│  → Does this serve the relationship?                         │"
echo "│  → Is this authentic, not robotic?                           │"
echo "│                                                              │"
echo "│  We believe in making AI human.                              │"
echo "└──────────────────────────────────────────────────────────────┘"
echo ""
