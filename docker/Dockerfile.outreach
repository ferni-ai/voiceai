# Outreach Worker Dockerfile
# Processes outreach triggers from Pub/Sub; runs as the Cloud Run Job
# "outreach-worker" (cloudbuild-outreach.yaml).
#
# Runs the TypeScript entrypoint with tsx, the same way Dockerfile.worker does.
# It used to esbuild-bundle the worker, but the bundle can't load: esbuild
# places a top-level await inside a non-async lazy-init wrapper ("Unexpected
# reserved word") and trips on native .node binaries. It also installed with
# npm, which can't resolve this pnpm workspace's workspace:* dependencies.

FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@10.29.3 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches/ ./patches/
COPY apps/cli/package.json ./apps/cli/
COPY apps/web/package.json ./apps/web/
COPY apps/async/package.json ./apps/async/
COPY apps/intelligence-worker/package.json ./apps/intelligence-worker/
COPY packages/shared-types/package.json ./packages/shared-types/

# Stubs for workspace packages not in the image (native crates, design system)
RUN mkdir -p apps/rust-audio apps/rust-perf design-system && \
    echo '{"name":"@ferni/audio","version":"0.1.0"}' > apps/rust-audio/package.json && \
    echo '{"name":"@ferni/perf","version":"0.1.0"}' > apps/rust-perf/package.json && \
    echo '{"name":"@ferni/design-system","version":"1.0.0"}' > design-system/package.json

# --no-frozen-lockfile: the stub package.json files differ from the lockfile's
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --prefer-offline --no-frozen-lockfile --ignore-scripts

COPY tsconfig.json ./
COPY src/ ./src/

ENV NODE_ENV=production
ENV GOOGLE_CLOUD_PROJECT=johnb-2025
ENV PUBSUB_ENABLED=true

CMD ["pnpm", "exec", "tsx", "src/workers/outreach-worker.ts"]
