# Outreach Worker Dockerfile
# Processes outreach triggers from Pub/Sub; runs as the Cloud Run Job
# "outreach-worker" (cloudbuild-outreach.yaml).
#
# Runs the TypeScript entrypoint with tsx, the same way Dockerfile.worker does.
# It used to esbuild-bundle the worker, but the bundle can't load: esbuild
# places a top-level await inside a non-async lazy-init wrapper ("Unexpected
# reserved word") and trips on native .node binaries. It also installed with
# npm, which can't resolve this pnpm workspace's workspace:* dependencies.

FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@10.29.3 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches/ ./patches/
COPY apps/cli/package.json ./apps/cli/
COPY apps/web/package.json ./apps/web/
COPY apps/async/package.json ./apps/async/
COPY apps/intelligence-worker/package.json ./apps/intelligence-worker/
COPY packages/shared-types/package.json ./packages/shared-types/

# The real package.json of every workspace package the lockfile names (none has install
# scripts), so the install can be frozen: the image gets exactly what CI tested.
COPY apps/rust-audio/package.json ./apps/rust-audio/
COPY apps/rust-perf/package.json ./apps/rust-perf/
COPY design-system/package.json ./design-system/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --prefer-offline --frozen-lockfile --ignore-scripts

COPY tsconfig.json ./
COPY src/ ./src/

ENV NODE_ENV=production
ENV GOOGLE_CLOUD_PROJECT=johnb-2025
ENV PUBSUB_ENABLED=true

CMD ["pnpm", "exec", "tsx", "src/workers/outreach-worker.ts"]
