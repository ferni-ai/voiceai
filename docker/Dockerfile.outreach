# Outreach Worker Dockerfile
# Processes outreach triggers from Pub/Sub
# Runs as a Cloud Run Job, scheduled every 5 minutes
#
# Uses esbuild for fast bundling without type checking

FROM node:20-slim AS builder

WORKDIR /app

# The repo is a pnpm workspace (root package.json has workspace:* deps npm
# can't install), so install with pnpm the way docker/Dockerfile.ui does.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@10.29.3 --activate

# Package files first (cache layer); stubs stand in for workspace packages
# not in the image. --no-frozen-lockfile: the stubs differ from the lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches/ ./patches/
COPY apps/cli/package.json ./apps/cli/
COPY apps/web/package.json ./apps/web/
COPY apps/async/package.json ./apps/async/
COPY apps/intelligence-worker/package.json ./apps/intelligence-worker/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN mkdir -p apps/rust-audio apps/rust-perf design-system && \
    echo '{"name":"@ferni/audio","version":"0.1.0"}' > apps/rust-audio/package.json && \
    echo '{"name":"@ferni/perf","version":"0.1.0"}' > apps/rust-perf/package.json && \
    echo '{"name":"@ferni/design-system","version":"1.0.0"}' > design-system/package.json
RUN pnpm install --prefer-offline --no-frozen-lockfile --ignore-scripts

# Copy ALL source files (simplest approach for complex dependency graph)
COPY src/ ./src/

# Build the outreach worker with esbuild
RUN pnpm exec esbuild src/workers/outreach-worker.ts \
  --bundle \
  --platform=node \
  --target=node20 \
  --format=esm \
  --outfile=dist/workers/outreach-worker.js \
  --external:@livekit/* \
  --external:@google-cloud/* \
  --external:firebase-admin \
  --external:twilio \
  --external:pg \
  --external:@sendgrid/mail \
  --external:bullmq \
  --external:ioredis \
  --external:better-sqlite3 \
  --external:canvas \
  --external:sharp \
  --external:cartesia-js \
  --external:openai \
  --external:@anthropic-ai/sdk \
  --external:googleapis \
  --external:node-fetch \
  --banner:js="import { createRequire } from 'module';const require = createRequire(import.meta.url);"

# Production stage
FROM node:20-slim AS runner

WORKDIR /app

# The repo is a pnpm workspace (root package.json has workspace:* deps npm
# can't install), so install with pnpm the way docker/Dockerfile.ui does.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@10.29.3 --activate

# Production dependencies only (the bundle keeps these external)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches/ ./patches/
COPY apps/cli/package.json ./apps/cli/
COPY apps/web/package.json ./apps/web/
COPY apps/async/package.json ./apps/async/
COPY apps/intelligence-worker/package.json ./apps/intelligence-worker/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN mkdir -p apps/rust-audio apps/rust-perf design-system && \
    echo '{"name":"@ferni/audio","version":"0.1.0"}' > apps/rust-audio/package.json && \
    echo '{"name":"@ferni/perf","version":"0.1.0"}' > apps/rust-perf/package.json && \
    echo '{"name":"@ferni/design-system","version":"1.0.0"}' > design-system/package.json
RUN pnpm install --prod --prefer-offline --no-frozen-lockfile --ignore-scripts

# Copy built code
COPY --from=builder /app/dist ./dist

# Set environment
ENV NODE_ENV=production
ENV GOOGLE_CLOUD_PROJECT=johnb-2025
ENV PUBSUB_ENABLED=true

# Run the outreach worker
CMD ["node", "--max-old-space-size=512", "dist/workers/outreach-worker.js"]
