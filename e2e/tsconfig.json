{
  "//": "Type-checks the root E2E suite (Playwright does not): pnpm test:e2e:typecheck",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["*.spec.ts", "*.e2e.ts", "support/**/*.ts", "global-setup.ts", "vitest.api.config.ts", "../playwright.config.ts"]
}
