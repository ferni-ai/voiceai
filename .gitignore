frontend-typescript/src/config/persona-colors.generated.ts
frontend-typescript/src/config/animation-constants.generated.ts
frontend-typescript/public/design-system/manifest.json
design-system/dist/
design-system/storybook-static/

# Brand docs - source of truth is design-system/brand/
