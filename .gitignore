# These platform copies are created during capacitor sync / build
apps/ios/ios/App/App/public/design-system/brand/
apps/android/android/app/src/main/assets/public/design-system/brand/
apps/web/dist/design-system/brand/

# Generated Tailwind config for promo site
promo/ferni-website/tailwind.config.generated.js

