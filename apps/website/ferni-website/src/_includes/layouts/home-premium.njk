<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/_tokens.css">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  
  {# ====== FONTS (Single Source of Truth) ====== #}
  {% include "partials/fonts.njk" %}
  
  {# Favicon #}
  <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
  
  {# Styles #}
  <style>
    /* Critical CSS inline for performance */
    
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    a { text-decoration: none; color: inherit; }
    
    html {
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }
    
    body {
      font-family: var(--font-body);
      background: var(--color-paper);
      color: var(--color-ink-deep);
      line-height: 1.5;
    }
    
    /* Prevent FOUC */
    .hero-premium { opacity: 0; animation: heroReveal var(--duration-slowest) ease var(--duration-faster) forwards; }
    @keyframes heroReveal { to { opacity: 1; } }
  </style>
  
  <link rel="stylesheet" href="/css/sections/hero-premium.css">
  
  {# OG Tags #}
  <meta property="og:title" content="{{ title }} | {{ site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ site.url }}/images/og-image.jpg">
  <meta property="og:url" content="{{ site.url }}">
  <meta name="twitter:card" content="summary_large_image">
</head>
<body>
  {# Premium Hero #}
  {% include "partials/home/hero-premium.njk" %}
  
  <main id="main-content">
    {{ content | safe }}
  </main>
</body>
</html>

