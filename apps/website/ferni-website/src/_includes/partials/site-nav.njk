{# ============================================================================
   SITE NAVIGATION - shared by every public page (rendered by story-brand.njk)
   Skip link + desktop nav + mobile menu. Active link from page.url.
   ============================================================================ #}
{% set navItems = [
  { url: "/capabilities/", label: "Capabilities", mobileLabel: "Capabilities" },
  { url: "/team/", label: "Team", mobileLabel: "Meet the Team" },
  { url: "/blog/", label: "Blog", mobileLabel: "Blog" },
  { url: "/about/", label: "About", mobileLabel: "About" }
] %}

<a href="#main-content" class="skip-link">Skip to main content</a>

<nav class="nav" id="nav" aria-label="Main navigation">
  <div class="nav__inner">
    <a href="/" class="nav__logo nav__logo--wordmark-only" aria-label="Ferni home">
      <span class="nav__logo-text">Ferni</span>
    </a>

    <ul class="nav__links">
      {% for item in navItems %}
      <li><a href="{{ item.url }}" class="nav__link{% if page.url.startsWith(item.url) %} is-active{% endif %}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}
    </ul>

    <a href="{{ site.appUrl }}" class="nav__cta nav__cta--desktop">
      Get Started
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>

    <button class="nav__hamburger" id="mobileMenuToggle" aria-label="Open menu" aria-controls="mobileMenu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu__header">
    <span class="nav__logo-text">Ferni</span>
    <button class="mobile-menu__close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>
  <nav class="mobile-menu__nav" aria-label="Mobile navigation">
    {% for item in navItems %}
    <a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.mobileLabel }}</a>
    {% endfor %}
    <a href="/contact/">Contact</a>
    <a href="tel:{{ site.phoneRaw }}">Call {{ site.phone }}</a>
  </nav>
  <div class="mobile-menu__cta">
    <a href="{{ site.appUrl }}" class="btn btn--primary btn--lg">
      Get Started Free
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</div>
