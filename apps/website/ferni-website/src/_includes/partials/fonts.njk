{# ============================================================================
   FERNI FONTS - SINGLE SOURCE OF TRUTH
   ============================================================================
   All font loading MUST go through this partial to prevent missing font weights.
   
   REQUIRED WEIGHTS:
   - Inter: 400 (body), 500 (medium), 600 (semibold), as one variable range
   - Plus Jakarta Sans: 400 (regular headlines), 500 (medium), 600 (semibold), 
                        700 (bold), 800 (extrabold)
   - JetBrains Mono: 400 (code), 500 (code medium) - only load when needed
   
   USAGE:
   {% include "partials/fonts.njk" %}
   OR with JetBrains Mono:
   {% set includeMonoFont = true %}
   {% include "partials/fonts.njk" %}
   ============================================================================ #}

{# Preconnect to Google Fonts for faster loading #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

{# Main fonts - Plus Jakarta Sans for display, Inter for body.
   Both are variable fonts: one woff2 per subset covers the whole weight
   range, so we ask for ranges (Inter 400..600, Jakarta 400..800) rather
   than a list of weights. The stylesheet is loaded without blocking first
   paint (display=swap shows the fallback until the face arrives). #}
{% if includeMonoFont %}
{% set googleFontsUrl = "https://fonts.googleapis.com/css2?family=Inter:wght@400..600&family=Plus+Jakarta+Sans:wght@400..800&family=JetBrains+Mono:wght@400;500&display=swap" %}
{% else %}
{% set googleFontsUrl = "https://fonts.googleapis.com/css2?family=Inter:wght@400..600&family=Plus+Jakarta+Sans:wght@400..800&display=swap" %}
{% endif %}
{# Preload the latin display face used by every hero headline. This URL must
   match the latin @font-face src in the Google Fonts CSS above; if Google
   bumps the version, update it (Chrome warns "preloaded but not used"). #}
<link rel="preload" href="https://fonts.gstatic.com/s/plusjakartasans/v12/LDIoaomQNQcsA88c7O9yZ4KMCoOg4Ko20yw.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ googleFontsUrl }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ googleFontsUrl }}"></noscript>
