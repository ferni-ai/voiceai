# Frontend Environment Configuration
# Copy this file to .env.local for local development overrides
# These values are embedded in the built frontend, so don't put secrets here!

# =============================================================================
# FIREBASE (sign-in) — required for local dev
# Without these, `vite` swaps Firebase for a stub and nobody can sign in.
# Production reads them from Firebase Hosting (/__/firebase/init.json); locally,
# copy the same public values from https://johnb-2025.web.app/__/firebase/init.json
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# =============================================================================
# DEV PROXY TARGET (optional)
# Port of the UI server the Vite dev proxy forwards /api, /token, /ws/... to.
# Default 3002. To run a second checkout beside one already on 3002, set it in
# the shell for BOTH commands (the root `pnpm ui-server` script reads it too):
#   UI_SERVER_PORT=3012 pnpm ui-server
#   UI_SERVER_PORT=3012 pnpm exec vite --port 3014
# =============================================================================
# UI_SERVER_PORT=3002

# =============================================================================
# PUSH NOTIFICATIONS (Web Push / VAPID)
# Generate your own key pair: npx web-push generate-vapid-keys
# =============================================================================
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# =============================================================================
# PRODUCTION API URLs (only needed for production builds)
# Leave empty to use relative URLs (if frontend served from same domain)
# =============================================================================
# VITE_TOKEN_SERVER_URL=https://api.yourdomain.com
# VITE_UI_SERVER_URL=https://app.yourdomain.com

# =============================================================================
# FEATURE FLAGS (optional)
# =============================================================================
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEBUG_MODE=false

# =============================================================================
# GOOGLE ONE-TAP SIGN-IN
# Uses same OAuth client as Calendar. Get from Google Cloud Console.
# =============================================================================
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
