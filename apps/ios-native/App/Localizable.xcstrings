    "Couldn't save that. Try again?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ ذلك. هل تود المحاولة مجددًا؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte nicht gespeichert werden. Versuchst du es noch mal?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save that. Try again?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar. ¿Quieres intentar de nuevo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer. Réessayer ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לשמור את זה. לנסות שוב?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした。もう一度試してみてくださいね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 못했어요. 다시 시도해 볼까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存。要再试一次吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存。要再試一次嗎？"
          }
        }
      }
    },
    "Couldn't send that. Try again?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الإرسال. هل تودون المحاولة مجدداً؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht gesendet werden. Erneut versuchen?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't send that. Try again?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar. ¿Quieres volver a intentarlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'envoyer ça. On réessaie ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לשלוח את זה. לנסות שוב?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できませんでした。もう一度試してみますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송하지 못했어요. 다시 시도해 볼까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能发送成功。再试一次？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法傳送。要再試一次嗎？"
          }
        }
      }
    },
