<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export straight to App Store Connect (TestFlight). -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>XT8W26YE9U</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Xcode picks the next free build number on upload. -->
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
	<key>uploadSymbols</key>
	<true/>
	<!-- false, so the build that internal testers try can also go to App Review.
	     A build uploaded as internal-only can never be submitted, and the build
	     Apple reviews must be the one we tested (#2868). Uploading doesn't send
	     it to external testers or to review: both are separate steps in App
	     Store Connect. -->
	<key>testFlightInternalTestingOnly</key>
	<false/>
</dict>
</plist>
