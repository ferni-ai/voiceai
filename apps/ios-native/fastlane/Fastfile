# Ferni for iPhone: build and upload to TestFlight (internal testers only).
#
# Needs an App Store Connect API key (Admin role, so Xcode can manage the
# distribution certificate and profile itself):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (the .p8 file's text)
# Signing is Xcode's automatic signing with team XT8W26YE9U; nothing about
# signing is stored in the repo.

default_platform(:ios)

platform :ios do
  desc "Build a Release archive and upload it to TestFlight for internal testing"
  lane :beta do
    key_path = File.expand_path("asc-key.p8", Dir.tmpdir)
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )

    # One past the newest build App Store Connect has (1.0.0 (6) is in use).
    latest = latest_testflight_build_number(api_key: api_key, initial_build_number: 6)
    build = [latest, 6].max + 1

    gym(
      project: "Ferni.xcodeproj",
      scheme: "Ferni",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build}",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" ")
    )

    pilot(
      api_key: api_key,
      distribute_external: false,
      skip_waiting_for_build_processing: true,
      changelog: "Build #{build} from #{ENV.fetch('GITHUB_SHA', 'local')[0, 9]}"
    )
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
