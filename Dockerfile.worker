# Dockerfile for Ferni Pub/Sub Worker Service
#
# Build: docker build -f Dockerfile.worker -t ferni-worker .
# Deploy: .github/workflows/deploy-worker.yml (manual dispatch)
#
# The repo is a pnpm workspace: the root package.json depends on workspace:*
# packages, which npm can't install, so this image installs with pnpm the way
# docker/Dockerfile.ui does (it used `npm ci` against a stale package-lock.json
# and could never build).

FROM node:22-slim

# curl for the healthcheck, git for git dependencies, pnpm via corepack
RUN apt-get update && apt-get install -y --no-install-recommends curl git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@10.29.3 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches/ ./patches/
COPY apps/cli/package.json ./apps/cli/
COPY apps/web/package.json ./apps/web/
COPY apps/async/package.json ./apps/async/
COPY apps/intelligence-worker/package.json ./apps/intelligence-worker/
COPY packages/shared-types/package.json ./packages/shared-types/

# The real package.json of every workspace package the lockfile names (none has install
# scripts), so the install can be frozen: the image gets exactly what CI tested.
COPY apps/rust-audio/package.json ./apps/rust-audio/
COPY apps/rust-perf/package.json ./apps/rust-perf/
COPY design-system/package.json ./design-system/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --prefer-offline --frozen-lockfile --ignore-scripts

COPY tsconfig.json ./
COPY src/ ./src/
COPY design-system/ ./design-system/

ENV NODE_ENV=production
ENV PORT=8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080

# Runs TypeScript directly with tsx (a root devDependency, installed above)
CMD ["pnpm", "exec", "tsx", "src/services/pubsub/worker-main.ts"]
